generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// SYSTEM CONFIG (singleton — global toggles)
// ============================================================
model SystemConfig {
  id                    Int       @id @default(1)
  multiCurrencyEnabled  Boolean   @default(false) @map("multi_currency_enabled")
  defaultCurrencyId     String?   @map("default_currency_id")
  defaultCurrency       Currency? @relation(fields: [defaultCurrencyId], references: [id])
  defaultLanguage       String    @default("en") @map("default_language")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  @@map("system_config")
}

// ============================================================
// CURRENCY / EXCHANGE RATE (future-proofed, toggle-gated)
// ============================================================
model Currency {
  id            String         @id @default(uuid())
  code          String         @unique
  symbol        String
  isActive      Boolean        @default(true) @map("is_active")
  createdAt     DateTime       @default(now()) @map("created_at")

  branches      Branch[]
  transactions  Transaction[]
  topups        Topup[]
  systemConfigs SystemConfig[]
  ratesFrom     ExchangeRate[] @relation("RateFrom")
  ratesTo       ExchangeRate[] @relation("RateTo")

  @@map("currency")
}

model ExchangeRate {
  id               String   @id @default(uuid())
  fromCurrencyId   String   @map("from_currency_id")
  toCurrencyId     String   @map("to_currency_id")
  fromCurrency     Currency @relation("RateFrom", fields: [fromCurrencyId], references: [id])
  toCurrency       Currency @relation("RateTo", fields: [toCurrencyId], references: [id])
  rate             Decimal  @db.Decimal(18, 6)
  effectiveDate    DateTime @map("effective_date") @db.Date
  createdAt        DateTime @default(now()) @map("created_at")

  @@unique([fromCurrencyId, toCurrencyId, effectiveDate])
  @@map("exchange_rate")
}

// ============================================================
// SUPER ADMIN — root of the whole system
// ============================================================
model SuperAdmin {
  id                 String   @id @default(uuid())
  name               String
  email              String   @unique
  passwordHash       String   @map("password_hash")
  preferredLanguage  String   @default("en") @map("preferred_language")
  isActive           Boolean  @default(true) @map("is_active")
  createdAt          DateTime @default(now()) @map("created_at")

  branchesCreated    Branch[]
  topupsInitiated    Topup[]
  auditLogs          AuditLog[]

  @@map("super_admin")
}

// ============================================================
// BRANCH
// ============================================================
model Branch {
  id                     String   @id @default(uuid())
  name                   String
  location               String?
  address                String?
  phone                  String?
  branchCode             String?  @unique @map("branch_code")
  status                 String   @default("INACTIVE") // ACTIVE | INACTIVE
  managerId              String?  @unique @map("manager_id")
  manager                AppUser? @relation("BranchManager", fields: [managerId], references: [id])
  currencyId             String?  @map("currency_id")
  currency               Currency? @relation(fields: [currencyId], references: [id])
  defaultLanguage        String   @default("en") @map("default_language")
  createdBySuperAdminId  String   @map("created_by_super_admin_id")
  createdBySuperAdmin    SuperAdmin @relation(fields: [createdBySuperAdminId], references: [id])
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  users                  AppUser[]            @relation("BranchStaff")
  commissionTiers        CommissionTier[]
  sentTransactions       Transaction[]        @relation("SenderBranch")
  receivedTransactions   Transaction[]        @relation("ReceiverBranch")
  subLedgerEntries       SubLedgerEntry[]
  generalLedgerEntries   GeneralLedgerEntry[]
  topups                 Topup[]

  @@map("branch")
}

// ============================================================
// APP USER — tellers & branch managers
// ============================================================
model AppUser {
  id                 String   @id @default(uuid())
  name               String
  email              String   @unique
  passwordHash       String   @map("password_hash")
  role               String   // TELLER | BRANCH_MANAGER
  branchId           String   @map("branch_id")
  branch             Branch   @relation("BranchStaff", fields: [branchId], references: [id])
  preferredLanguage  String   @default("en") @map("preferred_language")
  isActive           Boolean  @default(true) @map("is_active")
  createdAt          DateTime @default(now()) @map("created_at")

  managesBranch      Branch?  @relation("BranchManager")
  createdTransactions   Transaction[] @relation("CreatedByTeller")
  completedTransactions Transaction[] @relation("CompletedByTeller")
  refundedTransactions  Transaction[] @relation("RefundedByTeller")
  topupsReceived     Topup[]  @relation("BranchManagerTopup")
  auditLogs          AuditLog[]

  @@map("app_user")
}

// ============================================================
// COMMISSION TIER — per branch, versioned
// ============================================================
model CommissionTier {
  id                  String    @id @default(uuid())
  branchId            String    @map("branch_id")
  branch              Branch    @relation(fields: [branchId], references: [id])
  minAmount           Decimal   @map("min_amount") @db.Decimal(18, 2)
  maxAmount           Decimal   @map("max_amount") @db.Decimal(18, 2)
  commissionType      String    @default("PERCENTAGE") @map("commission_type") // PERCENTAGE | FLAT
  commissionPercent   Decimal?  @map("commission_percent") @db.Decimal(5, 2)
  commissionFlatAmount Decimal? @map("commission_flat_amount") @db.Decimal(18, 2)
  activeFrom          DateTime  @default(now()) @map("active_from")
  activeTo            DateTime? @map("active_to")
  createdAt           DateTime  @default(now()) @map("created_at")

  transactions        Transaction[]

  @@index([branchId, activeFrom, activeTo])
  @@map("commission_tier")
}

// ============================================================
// TRANSACTION — the core money movement
// ============================================================
model Transaction {
  id                  String    @id @default(uuid())
  type                String    @default("TRANSFER")
  senderBranchId      String    @map("sender_branch_id")
  senderBranch        Branch    @relation("SenderBranch", fields: [senderBranchId], references: [id])
  receiverBranchId    String    @map("receiver_branch_id")
  receiverBranch      Branch    @relation("ReceiverBranch", fields: [receiverBranchId], references: [id])
  senderName          String    @map("sender_name")
  senderIdNumber       String?   @map("sender_id_number")
  receiverName        String    @map("receiver_name")
  amountSent          Decimal   @map("amount_sent") @db.Decimal(18, 2)
  commissionAmount    Decimal   @default(0) @map("commission_amount") @db.Decimal(18, 2)
  amountPayable       Decimal   @map("amount_payable") @db.Decimal(18, 2)
  currencyId          String?   @map("currency_id")
  currency            Currency? @relation(fields: [currencyId], references: [id])
  commissionTierId    String?   @map("commission_tier_id")
  commissionTier      CommissionTier? @relation(fields: [commissionTierId], references: [id])
  pickupCode          String    @unique @map("pickup_code") @db.Char(16)
  qrCodeData          String?   @map("qr_code_data")
  status               String    @default("PENDING") // PENDING | COMPLETED | REFUNDED

  createdById         String    @map("created_by")
  createdBy           AppUser   @relation("CreatedByTeller", fields: [createdById], references: [id])
  completedById       String?   @map("completed_by")
  completedBy         AppUser?  @relation("CompletedByTeller", fields: [completedById], references: [id])
  refundedById        String?   @map("refunded_by")
  refundedBy           AppUser?  @relation("RefundedByTeller", fields: [refundedById], references: [id])

  createdAt           DateTime  @default(now()) @map("created_at")
  completedAt          DateTime? @map("completed_at")
  refundedAt            DateTime? @map("refunded_at")

  subLedgerEntries     SubLedgerEntry[]
  generalLedgerEntries GeneralLedgerEntry[]

  @@index([status])
  @@index([senderBranchId, createdAt])
  @@index([receiverBranchId, createdAt])
  @@map("transaction")
}

// ============================================================
// SUB LEDGER — written immediately (pending + settled movement)
// ============================================================
model SubLedgerEntry {
  id             String   @id @default(uuid())
  branchId       String   @map("branch_id")
  branch         Branch   @relation(fields: [branchId], references: [id])
  transactionId  String   @map("transaction_id")
  transaction    Transaction @relation(fields: [transactionId], references: [id])
  entryType      String   @map("entry_type") // PENDING_IN | PENDING_OUT | COMPLETED_IN | COMPLETED_OUT | REFUNDED_OUT
  amount         Decimal  @db.Decimal(18, 2)
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([branchId, createdAt])
  @@map("sub_ledger_entry")
}

// ============================================================
// GENERAL LEDGER — only written on COMPLETED / REFUNDED / TOPUP
// ============================================================
model GeneralLedgerEntry {
  id             String       @id @default(uuid())
  branchId       String       @map("branch_id")
  branch         Branch       @relation(fields: [branchId], references: [id])
  transactionId  String?      @map("transaction_id")
  transaction    Transaction? @relation(fields: [transactionId], references: [id])
  topupId        String?      @map("topup_id")
  topup          Topup?       @relation(fields: [topupId], references: [id])
  sourceType     String       @map("source_type") // TRANSACTION | TOPUP | ADJUSTMENT
  amount         Decimal      @db.Decimal(18, 2)
  postedAt       DateTime     @default(now()) @map("posted_at")

  @@index([branchId, postedAt])
  @@map("general_ledger_entry")
}

// ============================================================
// TOPUP — super admin only, signed A4 receipt flow
// ============================================================
model Topup {
  id                String    @id @default(uuid())
  branchId          String    @map("branch_id")
  branch            Branch    @relation(fields: [branchId], references: [id])
  amount            Decimal   @db.Decimal(18, 2)
  currencyId        String?   @map("currency_id")
  currency          Currency? @relation(fields: [currencyId], references: [id])
  initiatedById     String    @map("initiated_by")
  initiatedBy       SuperAdmin @relation(fields: [initiatedById], references: [id])
  branchManagerId   String    @map("branch_manager_id")
  branchManager     AppUser   @relation("BranchManagerTopup", fields: [branchManagerId], references: [id])
  receiptNumber     String    @unique @map("receipt_number")
  status            String    @default("ISSUED") // ISSUED | ACKNOWLEDGED
  note              String?
  createdAt         DateTime  @default(now()) @map("created_at")
  acknowledgedAt    DateTime? @map("acknowledged_at")

  generalLedgerEntries GeneralLedgerEntry[]

  @@map("topup")
}

// ============================================================
// AUDIT LOG — cross-cutting record of meaningful actions
// ============================================================
model AuditLog {
  id                 String    @id @default(uuid())
  entityType         String    @map("entity_type")
  entityId           String    @map("entity_id")
  action             String
  performedByUserId  String?   @map("performed_by_user")
  performedByUser    AppUser?  @relation(fields: [performedByUserId], references: [id])
  performedByAdminId String?   @map("performed_by_admin")
  performedByAdmin   SuperAdmin? @relation(fields: [performedByAdminId], references: [id])
  metadata           Json?
  createdAt          DateTime  @default(now()) @map("created_at")

  @@index([entityType, entityId])
  @@map("audit_log")
}
